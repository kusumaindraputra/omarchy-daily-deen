#!/usr/bin/env bash
#
# Data plane for the Daily Ayah & Hadith plugin.
#
# Everything that touches the network or a multi-megabyte JSON file happens
# here, out of process. omarchy-shell is a single Quickshell process on a single
# GUI thread: a JSON.parse of a 4.8 MB hadith edition there would freeze the
# bar, the panels, the notification daemon and the lock screen for as long as it
# took. jq does that work in a subprocess and QML only ever sees the ~2 KB pick.
#
#   deen-fetch catalog [--force]
#   deen-fetch sync    --quran SLUG [--quran-translation SLUG] [--hadith SLUG]
#                      [--hadith-arabic SLUG] [--force]
#   deen-fetch pick    [--force] [--offline] [options...]
#   deen-fetch status
#
# pick is idempotent and does its own due check, so a caller can simply run it
# on a timer and read stdout.

set -euo pipefail

VERSION="0.1.0"
QURAN_API="https://cdn.jsdelivr.net/gh/fawazahmed0/quran-api@1"
HADITH_API="https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-daily-deen"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-daily-deen"
GRADES_JQ="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/grades.jq"

CATALOG="$CACHE_DIR/catalog.json"
CURRENT="$STATE_DIR/current.json"
SEEN="$STATE_DIR/seen.json"
SEEN_MAX=60

OFFLINE=0

# Nothing upstream promises a size. The largest edition in the corpus is about
# 6.6 MB, so these leave room to grow while still bounding what a hostile or
# broken CDN response can cost: curl is told to refuse a declared length over
# the cap, and the delivered bytes are measured again before the file is
# accepted, because a chunked or compressed response need not declare one.
MAX_EDITION_BYTES=33554432   # 32 MiB
MAX_CATALOG_BYTES=8388608    # 8 MiB

# Edition slugs arrive inside the downloaded catalogs, and each one is pasted
# into both a URL and a cache path. A slug carrying a slash or a .. would put a
# CDN response somewhere else under the user's account entirely.
SLUG_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'

# What each endpoint has to look like before its body is allowed near the cache.
# "It parsed" is not the same as "it is the document we asked for", and the
# difference shows up later as a division by zero or an empty index rather than
# as a download problem.
SHAPE_EDITIONS='(type == "object") and (keys | length) > 0'
SHAPE_INFO='(.chapters | type) == "array" and (.chapters | length) == 114'
SHAPE_QURAN='(.quran | type) == "array" and (.quran | length) > 0'
SHAPE_HADITH='(.hadiths | type) == "array" and (.hadiths | length) > 0'

die() { echo "deen-fetch: $*" >&2; exit 1; }

valid_slug() {
  local s="${1:-}"
  [[ -n $s ]] || return 1
  [[ $s == *..* ]] && return 1
  [[ $s =~ $SLUG_RE ]]
}

# An empty slug means "not configured", which is a legitimate setting. A
# non-empty one that fails the pattern is refused outright rather than
# sanitised: there is no reading of it that we want to act on.
require_slug() {
  local s="${1:-}" what="$2"
  [[ -n $s ]] || return 0
  valid_slug "$s" || die "refusing $what slug: $s"
}
note() { [[ -n ${DEEN_DEBUG:-} ]] && echo "deen-fetch: $*" >&2 || true; }
now_ms() { echo $(( $(date +%s) * 1000 )); }

# Atomic because readers are live: the shell has a FileView watching
# current.json, and a torn read there is a parse error in the bar.
write_atomic() {
  local dest="$1" tmp
  mkdir -p "$(dirname "$dest")"
  tmp="$(mktemp "$(dirname "$dest")/.$(basename "$dest").XXXXXX")"
  cat > "$tmp"
  # Nothing here ever has a legitimate empty result, so an empty one means the
  # jq upstream of us died. Writing it would cache a zero-byte file that later
  # reads treat as a document.
  if [[ ! -s $tmp ]]; then
    rm -f "$tmp"
    note "refusing to write an empty $dest"
    return 1
  fi
  mv -f "$tmp" "$dest"
}

# Conditional GET. The @1 tag is mutable upstream, so an ETag is how we notice a
# new edition without re-downloading megabytes on every sync.
# A bounded download.
#
# curl's body goes through head, which stops one byte past the cap and closes the
# pipe; curl dies of SIGPIPE right there. The ceiling is enforced while the bytes
# are arriving rather than after they have all landed, which is the whole point:
# --max-filesize only refuses a response that declares its length, and a chunked
# or compressed one need not declare anything. It is kept as the cheap early
# refusal for the responses that do.
#
# At most max+1 bytes ever reach the disk, and in practice fewer: curl aborts at
# the cap itself with exit 63 before head has to.
#
#   0  a body within the cap. Empty is legitimate: that is how a 304 arrives.
#   1  the transfer failed
#   2  the response ran past the cap and was thrown away
bounded_get() {
  local url="$1" out="$2" max="$3" etag_file="$4"; shift 4
  local rc size

  # PIPESTATUS is the only way to see curl's own status through a pipe, and it
  # survives exactly one command, so errexit and pipefail come off around the
  # pipeline and go straight back on.
  set +o pipefail +e
  curl -fsS --compressed --max-time 120 --retry 2 --retry-delay 1 \
       --max-filesize "$max" --etag-save "$etag_file" "$@" \
       -o - "$url" 2>/dev/null | head -c $(( max + 1 )) > "$out"
  rc=${PIPESTATUS[0]}
  set -o pipefail -e

  size="$(wc -c < "$out" 2>/dev/null || echo 0)"
  # 63 is CURLE_FILESIZE_EXCEEDED. Current curl does police a chunked transfer
  # against --max-filesize as it runs and aborts at the cap; that it does is a
  # property of the version installed, not a guarantee, which is what head is
  # there for. Either ceiling means the same thing — the response is refused,
  # never truncated and kept.
  if (( size > max )) || (( rc == 63 )); then
    : > "$out"
    # The etag would otherwise vouch for a body we refused, and the next run
    # would ask conditionally and be told nothing had changed.
    rm -f "$etag_file"
    note "stopped an oversized response for $url at $size bytes (cap $max)"
    return 2
  fi
  if (( rc != 0 )); then rm -f "$etag_file"; return 1; fi
  return 0
}

# The optional 5th argument is a jq filter the body has to satisfy before it is
# allowed to replace what is cached. A response that parses is not yet the
# document we asked for, and the cheapest moment to say so is before the move.
fetch() {
  local url="$1" dest="$2" force="${3:-0}" max="${4:-$MAX_EDITION_BYTES}" check="${5:-}" etag_file
  etag_file="$CACHE_DIR/etag/$(echo -n "$url" | md5sum | cut -d' ' -f1)"
  mkdir -p "$CACHE_DIR/etag" "$(dirname "$dest")"

  if (( OFFLINE )); then
    [[ -s $dest ]] && return 0
    return 1
  fi

  # Conditional only when there is something to be conditional about.
  local cond=()
  if (( ! force )) && [[ -s $dest ]] && [[ -s $etag_file ]]; then
    cond=(--etag-compare "$etag_file")
  fi

  local tmp rc; tmp="$(mktemp)"
  bounded_get "$url" "$tmp" "$max" "$etag_file" "${cond[@]}"; rc=$?

  if (( rc == 0 )); then
    # An empty body is how a 304 arrives, and a zero-byte 200 is no use to us
    # either, so both mean: keep what is cached. That is why -w '%{http_code}'
    # is gone — it cannot share stdout with the body.
    if [[ -s $tmp ]]; then
      if [[ -n $check ]] && ! jq -e "$check" "$tmp" >/dev/null 2>&1; then
        rm -f "$tmp" "$etag_file"
        note "refusing $url: the response is not shaped like what was asked for"
        [[ -s $dest ]] && return 0
        return 1
      fi
      mv -f "$tmp" "$dest"
    else
      rm -f "$tmp"
    fi
    return 0
  fi

  rm -f "$tmp"
  # Refused or unreachable, a cached copy still beats nothing.
  [[ -s $dest ]] && return 0
  return 1
}

# ----------------------------------------------------------------- catalog

cmd_catalog() {
  local force=0
  while (( $# )); do case $1 in --force) force=1;; *) die "unknown flag $1";; esac; shift; done

  local q h info
  q="$CACHE_DIR/raw/quran-editions.json"
  h="$CACHE_DIR/raw/hadith-editions.json"
  info="$CACHE_DIR/raw/quran-info.json"

  fetch "$QURAN_API/editions.min.json"  "$q"    "$force" "$MAX_CATALOG_BYTES" "$SHAPE_EDITIONS" || die "cannot reach quran editions and no cache"
  fetch "$HADITH_API/editions.json"     "$h"    "$force" "$MAX_CATALOG_BYTES" "$SHAPE_EDITIONS" || die "cannot reach hadith editions and no cache"
  fetch "$QURAN_API/info.min.json"      "$info" "$force" "$MAX_CATALOG_BYTES" "$SHAPE_INFO"     || die "cannot reach quran info and no cache"

  # The top-level keys are underscore-form (eng_abdelhaleem); the URL slug lives
  # in .name (eng-abdelhaleem). Reading keys[] here would 404 every request.
  #
  # The -la / -lad suffixes are Latin transliterations rather than translations,
  # so they are flagged and kept out of the translation picker by default.
  # Slugs are dropped here as well as checked at the point of use, so a hostile
  # entry never reaches the cached catalog that the picker reads back.
  local built
  built="$(jq -n \
    --slurpfile q "$q" --slurpfile h "$h" --slurpfile info "$info" \
    --argjson now "$(now_ms)" --arg version "$VERSION" --arg slugre "$SLUG_RE" '
    {
      version: 1,
      fetchedAt: $now,
      generatedBy: ("deen-fetch " + $version),
      quran: ( $q[0] | to_entries | map(.value | {
          slug: .name, language: .language, author: .author,
          direction: (.direction // "ltr"),
          latin: (.name | test("-lad?[0-9]*$")),
          comments: (.comments // ""), source: (.source // "")
        }) | map(select((.slug | type) == "string"
                        and (.slug | test($slugre))
                        and (.slug | contains("..") | not)))
          | sort_by(.language, .author) ),
      hadith: ( $h[0] | to_entries | map(.key as $book | .value.collection[] | {
          slug: .name, book: $book, language: .language,
          direction: (.direction // "ltr"),
          hasSections: (.has_sections // false),
          comments: (.comments // "")
        }) | map(select((.slug | type) == "string"
                        and (.slug | test($slugre))
                        and (.slug | contains("..") | not)))
          | sort_by(.language, .book) ),
      books: ( $h[0] | to_entries | map({ key: .key, value: { name: .value.name } }) | from_entries ),
      surahs: ( $info[0].chapters | map({
          n: .chapter, name: .name, english: .englishname,
          arabic: .arabicname, revelation: .revelation,
          ayahs: (.verses | length)
        }) )
    }')" || die "cannot parse the edition lists"

  # A response can parse and still be useless. Caching an empty or truncated
  # catalog would break every later pick until the cache is cleared by hand, so
  # it is refused here and the previous catalog is left in place.
  local nq nh ns
  nq="$(jq '.quran  | length' <<<"$built")"
  nh="$(jq '.hadith | length' <<<"$built")"
  ns="$(jq '.surahs | length' <<<"$built")"
  (( nq > 0 && nh > 0 )) || die "catalog carries no usable editions (quran=$nq hadith=$nh)"
  (( ns == 114 )) || die "catalog lists $ns surahs, expected 114"

  printf '%s' "$built" | write_atomic "$CATALOG"

  jq -c '{quran: (.quran|length), hadith: (.hadith|length), books: (.books|length), surahs: (.surahs|length)}' "$CATALOG"
}

# ------------------------------------------------------------------- sync

quran_path()  { echo "$CACHE_DIR/quran/$1.json"; }
hadith_path() { echo "$CACHE_DIR/hadith/$1.json"; }
index_path()  { echo "$CACHE_DIR/index/$1.json"; }
meta_path()   { echo "$CACHE_DIR/index/$1.meta.json"; }

book_of() {
  [[ -s $CATALOG ]] || return 1
  jq -r --arg s "$1" '.hadith[] | select(.slug == $s) | .book' "$CATALOG" | head -1
}

sync_quran() {
  local slug="$1" force="${2:-0}"
  [[ -n $slug ]] || return 0
  valid_slug "$slug" || { note "refusing quran slug $slug"; return 1; }
  fetch "$QURAN_API/editions/$slug.min.json" "$(quran_path "$slug")" "$force" \
        "$MAX_EDITION_BYTES" "$SHAPE_QURAN" \
    || { note "quran edition $slug unavailable"; return 1; }
}

# Building the index is the whole reason the offline mode works. Hadith numbering
# is not contiguous — abudawud stops at 5274 but not every number below it
# exists — so picking a random number in a range 404s regularly. The index
# enumerates only numbers that are actually present, per grade class, so a pick
# can never miss.
sync_hadith() {
  local slug="$1" force="${2:-0}" authority="${3:-}" book path
  [[ -n $slug ]] || return 0
  valid_slug "$slug" || { note "refusing hadith slug $slug"; return 1; }
  path="$(hadith_path "$slug")"
  fetch "$HADITH_API/editions/$slug.min.json" "$path" "$force" \
        "$MAX_EDITION_BYTES" "$SHAPE_HADITH" \
    || { note "hadith edition $slug unavailable"; return 1; }

  book="$(book_of "$slug" || true)"
  [[ -n $book ]] || book="${slug#*-}"

  local idx; idx="$(index_path "$slug")"
  if (( ! force )) && [[ -s $idx ]] && [[ $idx -nt $path ]]; then
    local cached_auth; cached_auth="$(jq -r '.authority // ""' "$idx")"
    [[ $cached_auth == "$authority" ]] && return 0
  fi

  jq -c --arg book "$book" --arg slug "$slug" --arg auth "$authority" \
        --argjson now "$(now_ms)" -f <(cat "$GRADES_JQ"; cat <<'JQ'
    . as $doc
    | ($doc.hadiths | map({ n: .hadithnumber, c: hadith_grade_class($book; $auth) })) as $rows
    | {
        version: 1, edition: $slug, book: $book, authority: $auth,
        builtAt: $now,
        total: ($rows | length),
        classes: ( reduce $rows[] as $r ({}; .[$r.c] += [$r.n]) ),
        graders: ( $doc.hadiths | map(.grades // [] | map(.name)) | flatten | unique )
      }
JQ
  ) "$path" | write_atomic "$idx" || {
    # set -e is suppressed inside a function reached through `||`, which is how
    # cmd_sync calls this one, so the failure has to be handled rather than
    # trusted to abort. Without this the meta step reads an index that is not
    # there and complains twice about the same thing.
    note "could not build an index for $slug"
    return 1
  }

  jq -c '{edition, book, total, counts: (.classes | map_values(length)), graders}' "$idx" \
    | write_atomic "$(meta_path "$slug")" || {
    note "could not build index metadata for $slug"
    return 1
  }
}

cmd_sync() {
  local q="" qt="" h="" ha="" auth="" force=0
  while (( $# )); do
    case $1 in
      --quran) q="$2"; shift;;
      --quran-translation) qt="$2"; shift;;
      --hadith) h="$2"; shift;;
      --hadith-arabic) ha="$2"; shift;;
      --authority) auth="$2"; shift;;
      --force) force=1;;
      --offline) OFFLINE=1;;
      *) die "unknown flag $1";;
    esac; shift
  done
  require_slug "$q"  "quran"
  require_slug "$qt" "quran translation"
  require_slug "$h"  "hadith"
  require_slug "$ha" "hadith arabic"
  [[ -s $CATALOG ]] || cmd_catalog >/dev/null
  sync_quran  "$q"  "$force" || true
  sync_quran  "$qt" "$force" || true
  sync_hadith "$h"  "$force" "$auth" || true
  sync_hadith "$ha" "$force" "$auth" || true
  echo '{"ok":true}'
}

# ------------------------------------------------------------------- pick

# A stable 31-bit number from a string. Used for the deterministic mode, where
# the pick is a function of the clock slot and the settings rather than of
# chance — so two machines configured alike show the same ayah, and re-running
# pick inside one slot is a no-op instead of a reshuffle.
hash31() { printf '%s' "$1" | cksum | cut -d' ' -f1; }

rand31() { od -An -N4 -tu4 /dev/urandom | tr -d ' \n'; }

seen_has() { [[ -s $SEEN ]] && jq -e --arg k "$1" 'index($k) != null' "$SEEN" >/dev/null 2>&1; }
seen_push() {
  local key="$1" cur='[]'
  [[ -s $SEEN ]] && cur="$(cat "$SEEN")"
  jq -c --arg k "$key" --argjson max "$SEEN_MAX" \
    '(. // []) - [$k] + [$k] | if length > $max then .[length-$max:] else . end' \
    <<<"$cur" | write_atomic "$SEEN"
}

classes_for_filter() {
  case "$1" in
    any)         echo '["sahih","hasan","daif","maudu","unknown"]';;
    sahih)       echo '["sahih"]';;
    sahih-hasan) echo '["sahih","hasan"]';;
    daif)        echo '["daif"]';;
    *) die "unknown grade filter $1";;
  esac
}

cmd_pick() {
  local force=0 interval=6 mode="deterministic" no_sync=0
  local q="" qt="" h="" ha="" filter="sahih-hasan" auth=""
  local show_ayah=1 show_hadith=1

  while (( $# )); do
    case $1 in
      --force) force=1;;
      --offline) OFFLINE=1;;
      --no-sync) no_sync=1;;
      --interval-hours) interval="$2"; shift;;
      --mode) mode="$2"; shift;;
      --quran) q="$2"; shift;;
      --quran-translation) qt="$2"; shift;;
      --hadith) h="$2"; shift;;
      --hadith-arabic) ha="$2"; shift;;
      --grade-filter) filter="$2"; shift;;
      --authority) auth="$2"; shift;;
      --no-ayah) show_ayah=0;;
      --no-hadith) show_hadith=0;;
      *) die "unknown flag $1";;
    esac; shift
  done
  [[ $interval =~ ^[0-9]+$ ]] && (( interval >= 1 )) || interval=6
  require_slug "$q"  "quran"
  require_slug "$qt" "quran translation"
  require_slug "$h"  "hadith"
  require_slug "$ha" "hadith arabic"

  local fingerprint prev_fp prev_at now interval_ms
  fingerprint="$(hash31 "$q|$qt|$h|$ha|$filter|$auth|$interval|$mode|$show_ayah|$show_hadith")"
  now="$(now_ms)"
  interval_ms=$(( interval * 3600000 ))

  prev_fp=""; prev_at=0
  if [[ -s $CURRENT ]]; then
    prev_fp="$(jq -r '.fingerprint // ""' "$CURRENT" 2>/dev/null || echo "")"
    prev_at="$(jq -r '.chosenAt // 0' "$CURRENT" 2>/dev/null || echo 0)"
  fi

  # Comparing a persisted timestamp, rather than running a Timer whose interval
  # is the rotation period, is what makes the pick survive a shell restart and
  # makes a laptop that slept for eight hours rotate once on wake instead of
  # eight times.
  if (( ! force )) && [[ $prev_fp == "$fingerprint" ]] && (( now - prev_at < interval_ms )); then
    cat "$CURRENT"; return 0
  fi

  # Built as an array rather than ${OFFLINE:+--offline}: OFFLINE is 0 or 1, and
  # ":+" fires on any non-empty value, so "0" would have passed --offline on
  # every single pick and nothing would ever have been downloaded.
  local sync_flags=()
  (( OFFLINE )) && sync_flags+=(--offline)
  (( no_sync )) || cmd_sync --quran "$q" --quran-translation "$qt" \
      --hadith "$h" --hadith-arabic "$ha" --authority "$auth" \
      "${sync_flags[@]}" >/dev/null 2>&1 || true

  # A scheduled deterministic pick is a pure function of the slot and the
  # settings, which is what makes two machines configured alike agree on the
  # passage. A forced one cannot be, and must not try: --force skipped the due
  # check but left the seed alone, so inside one slot it re-derived the very
  # same seed and the refresh button re-picked the passage already on screen.
  #
  # Drawing at random on a force rather than mixing the clock into the hash is
  # deliberate: now_ms() has second resolution, so two presses inside one second
  # would still have hashed to the same seed. Asking for a new passage is an
  # explicit act; only the picks nobody asked for need to agree across machines.
  local slot seed varied=0
  slot=$(( now / interval_ms ))
  [[ $mode == random ]] && varied=1
  (( force )) && varied=1
  if (( varied )); then seed="$(rand31)"; else seed="$(hash31 "$fingerprint|$slot")"; fi

  local ayah_json="null" hadith_json="null" source="cache" fallback=false

  # ---- ayah
  if (( show_ayah )); then
    local primary="" secondary=""
    [[ -n $q  && -s $(quran_path "$q")  ]] && primary="$(quran_path "$q")"
    [[ -n $qt && -s $(quran_path "$qt") ]] && secondary="$(quran_path "$qt")"
    [[ -z $primary && -n $secondary ]] && { primary="$secondary"; secondary=""; }

    # A file cached by an older version of this script never went through the
    # shape check on the way in, so the modulo below cannot assume a count.
    local total=0 idx tries=0
    if [[ -n $primary ]]; then
      total="$(jq -r 'if (.quran | type) == "array" then (.quran | length) else 0 end' \
                 "$primary" 2>/dev/null || echo 0)"
      [[ $total =~ ^[0-9]+$ ]] || total=0
      if (( total <= 0 )); then
        note "cached quran edition at $primary is unusable"
        primary=""
      fi
    fi

    if [[ -n $primary ]]; then
      idx=$(( seed % total ))
      if (( varied )); then
        while (( tries < 20 )) && seen_has "ayah:$(jq -r --argjson i "$idx" '.quran[$i] | "\(.chapter):\(.verse)"' "$primary")"; do
          idx=$(( $(rand31) % total )); tries=$(( tries + 1 ))
        done
      fi
      ayah_json="$(jq -c --argjson i "$idx" \
        --arg ed "${q:-$qt}" --arg ted "$qt" \
        --slurpfile cat "$CATALOG" \
        --slurpfile tr "${secondary:-/dev/null}" '
        .quran[$i] as $a
        | ($cat[0].quran // [] | map({key:.slug, value:.}) | from_entries) as $eds
        | ($cat[0].surahs // [] | map(select(.n == $a.chapter)) | first) as $s
        | {
            edition: $ed,
            editionAuthor: ($eds[$ed].author // ""),
            language: ($eds[$ed].language // ""),
            direction: ($eds[$ed].direction // "ltr"),
            surah: $a.chapter, ayah: $a.verse, text: $a.text,
            surahName: ($s.name // ""), surahEnglish: ($s.english // ""),
            surahArabic: ($s.arabic // ""), ayahCount: ($s.ayahs // 0),
            translationEdition: $ted,
            translationAuthor: ($eds[$ted].author // ""),
            translationLanguage: ($eds[$ted].language // ""),
            translationDirection: ($eds[$ted].direction // "ltr"),
            translation: ( if ($tr | length) > 0
                           then ($tr[0].quran | map(select(.chapter == $a.chapter and .verse == $a.verse)) | first | .text // "")
                           else "" end )
          }' "$primary")"
      seen_push "ayah:$(jq -r '"\(.surah):\(.ayah)"' <<<"$ayah_json")"
    fi
  fi

  # ---- hadith
  if (( show_hadith )); then
    local hpath idx_file
    hpath="$(hadith_path "$h")"; idx_file="$(index_path "$h")"
    if [[ -n $h && -s $hpath && -s $idx_file ]]; then
      local wanted numbers count
      wanted="$(classes_for_filter "$filter")"
      numbers="$(jq -c --argjson want "$wanted" '[.classes | to_entries[] | select(.key as $k | $want | index($k)) | .value[]] | sort' "$idx_file")"
      count="$(jq 'length' <<<"$numbers")"

      # A book with no grade strings at all (Nawawi's Forty, Forty Qudsi) would
      # otherwise return nothing under any filter but "any". Falling back and
      # saying so beats showing an empty panel.
      if (( count == 0 )); then
        numbers="$(jq -c '[.classes[][]] | sort' "$idx_file")"
        count="$(jq 'length' <<<"$numbers")"
        fallback=true
      fi

      if (( count > 0 )); then
        local pos num tries=0
        pos=$(( (seed / 7 + seed) % count ))
        num="$(jq -r --argjson i "$pos" '.[$i]' <<<"$numbers")"
        if (( varied )); then
          while (( tries < 20 )) && seen_has "hadith:$h:$num"; do
            pos=$(( $(rand31) % count )); num="$(jq -r --argjson i "$pos" '.[$i]' <<<"$numbers")"
            tries=$(( tries + 1 ))
          done
        fi

        local arabic_file="/dev/null"
        [[ -n $ha && -s $(hadith_path "$ha") ]] && arabic_file="$(hadith_path "$ha")"

        hadith_json="$(jq -c --argjson n "$num" --arg ed "$h" --arg aed "$ha" \
          --slurpfile idx "$idx_file" --slurpfile cat "$CATALOG" \
          --slurpfile ar "$arabic_file" '
          .metadata as $meta
          | (.hadiths | map(select(.hadithnumber == $n)) | first) as $x
          | ($cat[0].hadith // [] | map({key:.slug, value:.}) | from_entries) as $eds
          | ($idx[0].classes // {} | to_entries | map(select(.value | index($n)) | .key) | first) as $cls
          | {
              edition: $ed, book: $idx[0].book,
              collectionName: ($meta.name // ""),
              language: ($eds[$ed].language // ""),
              direction: ($eds[$ed].direction // "ltr"),
              number: $x.hadithnumber, arabicNumber: ($x.arabicnumber // $x.hadithnumber),
              reference: ($x.reference // {}),
              section: ( ($meta.section // {}) | to_entries | first | .value // "" ),
              text: $x.text,
              grades: ($x.grades // []),
              gradeClass: ($cls // "unknown"),
              authority: $idx[0].authority,
              arabicEdition: $aed,
              arabicDirection: ($eds[$aed].direction // "rtl"),
              arabicText: ( if ($ar | length) > 0
                            then ($ar[0].hadiths | map(select(.hadithnumber == $n)) | first | .text // "")
                            else "" end )
            }' "$hpath")"
        seen_push "hadith:$h:$num"
      fi
    fi
  fi

  (( OFFLINE )) && source="offline" || source="network"

  # Say what could not be produced rather than silently showing half a panel.
  # Offline with an edition that was never cached is the common case.
  local unavailable="[]"
  (( show_ayah ))   && [[ $ayah_json   == "null" ]] && unavailable="$(jq -c '. + ["ayah"]' <<<"$unavailable")"
  (( show_hadith )) && [[ $hadith_json == "null" ]] && unavailable="$(jq -c '. + ["hadith"]' <<<"$unavailable")"

  if [[ $ayah_json == "null" && $hadith_json == "null" ]]; then
    # Nothing to show and nothing cached: keep whatever was on screen rather
    # than blanking the widget.
    [[ -s $CURRENT ]] && { cat "$CURRENT"; return 0; }
    die "no cached editions and nothing could be fetched"
  fi

  jq -n --argjson now "$now" --arg fp "$fingerprint" --argjson interval "$interval" \
        --arg mode "$mode" --arg source "$source" --arg filter "$filter" \
        --argjson fallback "$fallback" --arg version "$VERSION" \
        --argjson ayah "$ayah_json" --argjson hadith "$hadith_json" \
        --argjson unavailable "$unavailable" '
    { version: 1, chosenAt: $now, intervalHours: $interval, mode: $mode,
      fingerprint: $fp, source: $source, gradeFilter: $filter,
      gradeFallback: $fallback, unavailable: $unavailable,
      generatedBy: ("deen-fetch " + $version),
      ayah: $ayah, hadith: $hadith }' | write_atomic "$CURRENT"

  cat "$CURRENT"
}

cmd_status() {
  if [[ -s $CURRENT ]]; then cat "$CURRENT"
  else jq -n '{version:1, chosenAt:0, ayah:null, hadith:null, source:"empty"}'
  fi
}

# ------------------------------------------------------------- dispatcher

command -v jq   >/dev/null || die "jq is required"
command -v curl >/dev/null || die "curl is required"
[[ -s $GRADES_JQ ]] || die "grades.jq missing next to this script"
mkdir -p "$CACHE_DIR" "$STATE_DIR"

cmd="${1:-status}"; shift || true
case "$cmd" in
  catalog) cmd_catalog "$@";;
  sync)    cmd_sync "$@";;
  pick)    cmd_pick "$@";;
  status)  cmd_status "$@";;
  --version) echo "$VERSION";;
  -h|--help) sed -n '3,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//';;
  *) die "unknown command: $cmd";;
esac
